#!/usr/bin/env bash
set -euo pipefail

release_root="${HOME}/workshop-app"
release_id="$(date -u +%Y%m%dT%H%M%SZ)"
release_dir="${release_root}/releases/${release_id}"
image="workshop-app:${release_id}"

mkdir -p "${release_dir}"
tar -x -C "${release_dir}"

docker build --tag "${image}" "${release_dir}"
docker rm --force workshop-app >/dev/null 2>&1 || true
docker run \
  --detach \
  --name workshop-app \
  --restart unless-stopped \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --pids-limit 128 \
  --memory 512m \
  --publish 127.0.0.1:3000:3000 \
  "${image}"

for attempt in $(seq 1 20); do
  if curl --fail --silent http://127.0.0.1:3000/health >/dev/null; then
    ln -sfn "${release_dir}" "${release_root}/current"
    docker image prune --force --filter "until=168h" >/dev/null
    exit 0
  fi
  sleep 1
done

docker logs workshop-app
exit 1
