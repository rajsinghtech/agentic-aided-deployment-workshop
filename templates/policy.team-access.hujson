{
  "groups": {
    "group:workshop-team": [
      "AUTHOR_LOGIN",
      "TEAMMATE_LOGIN",
    ],
  },

  "tagOwners": {
    "tag:ci-deployer": ["autogroup:admin"],
    "tag:demo-host":   ["autogroup:admin"],
  },

  "autoApprovers": {
    "services": {
      "svc:workshop-app": ["tag:demo-host"],
    },
  },

  "grants": [
    {
      "src": ["tag:ci-deployer"],
      "dst": ["tag:demo-host"],
      "ip":  ["tcp:22"],
    },
    {
      "src": ["group:workshop-team"],
      "dst": ["svc:workshop-app"],
      "ip":  ["tcp:443"],
    },
  ],

  "ssh": [
    {
      "action": "accept",
      "src":    ["tag:ci-deployer"],
      "dst":    ["tag:demo-host"],
      "users":  ["deploy"],
    },
  ],

  "tests": [
    {
      "src":    "tag:ci-deployer",
      "proto":  "tcp",
      "accept": ["tag:demo-host:22"],
      "deny":   ["tag:demo-host:23", "svc:workshop-app:443"],
    },
    {
      "src":    "AUTHOR_LOGIN",
      "accept": ["svc:workshop-app:443"],
      "deny":   ["tag:demo-host:22"],
    },
    {
      "src":    "TEAMMATE_LOGIN",
      "accept": ["svc:workshop-app:443"],
      "deny":   ["tag:demo-host:22"],
    },
  ],
}
